DATABASE_URL="mysql://dashboard_user:dashboard_pass@localhost:3307/dashboard"
SHADOW_DATABASE_URL="mysql://root:rootpass@localhost:3307/dashboard_shadow"

DATABASE_HOST=localhost
DATABASE_PORT=3307
DATABASE_USER=dashboard_user
DATABASE_PASSWORD=dashboard_pass
DATABASE_NAME=dashboard

GITHUB_CLIENT_ID=...
GITHUB_CLIENT_SECRET=...
GITHUB_REDIRECT_URI=...

GOOGLE_API_SECRET=...
GOOGLE_REDIRECT_URI=...
GOOGLE_CLIENT_ID=...

DISCORD_CLIENT_ID=...
DISCORD_CLIENT_SECRET=...

# Signs login tokens. Long random string, keep it private.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=...
JWT_EXPIRES_IN=1d

# Email verification. Leave SMTP_HOST empty to print links to the console instead.
SMTP_HOST=
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Dashboard <no-reply@dashboard.local>"
# Where the verification link points (the React app)
FRONTEND_URL=http://localhost:5173
